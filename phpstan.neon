includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - src
    reportUnmatchedIgnoredErrors: true
    ignoreErrors:
        # Laravel's schema Blueprint skips commands whose compile method returns null;
        # the parent docblocks declare string.
        -
            identifier: return.type
            path: src/Schema/Grammar.php
            message: '#should return (string|array<string>) but returns null\.#'
        # SQL built from wrap()ped column names, not literal strings (Laravel 13's typing).
        -
            identifier: argument.type
            message: '#(whereRaw|orderByRaw)\(\) expects .*literal-string#'
            path: src/Query/Builder.php
        # Traits are used by applications' models.
        -
            identifier: trait.unused
