{
    "name": "vuthaihoc/laravel-xtdb2",
    "description": "An XTDB 2 database driver for Laravel: Eloquent, Query Builder and migrations over the PostgreSQL wire protocol, with bitemporal queries",
    "keywords": ["laravel", "eloquent", "xtdb", "bitemporal", "database", "driver", "postgres-wire"],
    "homepage": "https://github.com/vuthaihoc/laravel-xtdb2",
    "license": "MIT",
    "authors": [
        {
            "name": "vuthaihoc",
            "email": "vuthaihoc.ttud@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "symfony/uid": "^7.0 || ^8.0",
        "vuthaihoc/laravel-db-portable": "^0.7"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.17",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelXtdb\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelXtdb\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelXtdb\\XtdbServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit --colors",
        "test:unit": "phpunit --colors --testsuite=Unit",
        "test:feature": "phpunit --colors --testsuite=Feature",
        "test:known-issues": "phpunit --colors --testsuite=KnownIssues",
        "phpstan": "phpstan analyse --memory-limit=-1",
        "cs": "pint --test",
        "cs:fix": "pint"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
